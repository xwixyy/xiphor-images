# Скопируйте в .env.local для локальной разработки.
# В Vercel те же переменные задаются в Settings → Environment Variables.

# Строка подключения Neon (pooled). Пример:
# postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Токен Vercel Blob (создаётся автоматически при подключении Blob store к проекту).
BLOB_READ_WRITE_TOKEN=

# Случайная строка (32+ байт) для хеширования IP при лимитах.
# Сгенерировать: openssl rand -base64 32
IP_HASH_SECRET=

# Секрет для защиты маршрута очистки по расписанию Vercel Cron.
# Сгенерировать: openssl rand -base64 32
CRON_SECRET=

# Публичный домен сервиса (используется для генерации ссылок).
NEXT_PUBLIC_BASE_URL=https://img.xiphor.cc.cd
